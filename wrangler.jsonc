{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "constellation-study",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "constellation-study",
      "database_id": "c91716b0-1ce2-4dc7-8477-0e56bdc13d32",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "ALLOW_PUBLIC_RUNS": "false",
    "DATA_ENV": "production",
  },
  "env": {
    "local": {
      "vars": {
        "ALLOW_PUBLIC_RUNS": "false",
        "DATA_ENV": "local",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "constellation-study",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
